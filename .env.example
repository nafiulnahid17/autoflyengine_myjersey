# Autofly service
AUTOFLY_HOST=0.0.0.0
PORT=8000
AUTOFLY_ENGINE_TOKEN=replace-with-a-long-random-server-token
AUTOFLY_WORKSPACE=.runtime
AUTOFLY_MAX_UPLOAD_MIB=30
AUTOFLY_MAX_OUTSTANDING_JOBS=24
AUTOFLY_POLL_INTERVAL_SECONDS=2
AUTOFLY_JOB_TIMEOUT_SECONDS=1800

# Default Artboard AI upstream (required)
ARTBOARD_ENGINE_URL=https://your-artboard-engine.example.com
ARTBOARD_ENGINE_TOKEN=replace-with-artboard-private-token

# Optional mode-isolated upstreams. If omitted, the default upstream is used.
# This lets Autofly offer real Quality and Cost-Effective routing without
# modifying the Artboard AI repository. Each deployment can use its own
# OpenRouter model environment variables.
ARTBOARD_QUALITY_URL=
ARTBOARD_QUALITY_TOKEN=
ARTBOARD_COST_URL=
ARTBOARD_COST_TOKEN=

